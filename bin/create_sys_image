# Create a Julia system image including all project packages.
# The system image is saved as sys_MTKCircuits.so in the project root.
# Usage: bin/create_sys_image

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# Set up Python environment variables (JULIA_PYTHONCALL_EXE / JULIA_CONDAPKG_BACKEND)
# so the sysimage is compiled with the same Python that will be used at runtime.
. "$SCRIPT_DIR/setup_env"

julia --project="$PROJECT_DIR" "$SCRIPT_DIR/create_sys_image.jl"
